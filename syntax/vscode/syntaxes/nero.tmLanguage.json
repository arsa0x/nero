{
    "scopeName": "source.nero",
    "patterns": [
        {
            "match": "@(GET|POST|PUT|DELETE|PATCH|)",
            "name": "keyword.control.nero"
        },
        {
            "match": "#\\[[^\\]]+\\]",
            "name": "entity.name.label.nero"
        },
        {
            "match": "\\b(HEADERS|QUERY|BODY)\\b",
            "name": "keyword.block.nero"
        },
        {
            "match": "\"(?:\\\\.|[^\"\\\\])*\"",
            "name": "string.quoted.double.nero"
        },
        {
            "match": "\\$\\{[a-zA-Z_][a-zA-Z0-9_]*\\}",
            "name": "variable.interpolation.nero"
        },
        {
            "match": "\\b[0-9]+\\b",
            "name": "constant.numeric.nero"
        },
        {
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
            "name": "variable.other.nero"
        }
    ]
}